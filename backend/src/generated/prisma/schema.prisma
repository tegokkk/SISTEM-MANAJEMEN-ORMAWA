model work_program_status_history {
  id              BigInt                                   @id @default(autoincrement()) @db.UnsignedBigInt
  work_program_id BigInt                                   @db.UnsignedBigInt
  tenant_id       BigInt                                   @db.UnsignedBigInt
  from_status     work_program_status_history_from_status?
  to_status       work_program_status_history_to_status
  actor_user_id   BigInt                                   @db.UnsignedBigInt
  actor_tenant_id BigInt?                                  @db.UnsignedBigInt
  note            String?                                  @db.Text
  created_at      DateTime                                 @default(now())
  users           users                                    @relation(fields: [actor_user_id], references: [id], map: "fk_work_program_history_actor")
  tenants         tenants?                                 @relation(fields: [actor_tenant_id], references: [id], map: "fk_work_program_history_actor_tenant")
  work_programs   work_programs                            @relation(fields: [work_program_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, map: "fk_work_program_history_program_scope")

  @@index([actor_user_id], map: "fk_work_program_history_actor")
  @@index([actor_tenant_id], map: "fk_work_program_history_actor_tenant")
  @@index([work_program_id, tenant_id], map: "fk_work_program_history_program_scope")
  @@index([work_program_id, created_at], map: "idx_work_program_history_program")
}

model work_programs {
  id                                                BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                                         BigInt                        @db.UnsignedBigInt
  period_id                                         BigInt                        @db.UnsignedBigInt
  responsible_member_id                             BigInt?                       @db.UnsignedBigInt
  reviewer_tenant_id                                BigInt?                       @db.UnsignedBigInt
  code                                              String                        @db.VarChar(60)
  name                                              String                        @db.VarChar(180)
  description                                       String?                       @db.Text
  objective                                         String?                       @db.Text
  location                                          String?                       @db.VarChar(255)
  start_date                                        DateTime                      @db.Date
  end_date                                          DateTime                      @db.Date
  proposed_budget                                   Decimal                       @default(0.00) @db.Decimal(18, 2)
  approved_budget                                   Decimal?                      @db.Decimal(18, 2)
  status                                            work_programs_status          @default(DRAFT)
  created_by_user_id                                BigInt                        @db.UnsignedBigInt
  submitted_at                                      DateTime?
  approved_at                                       DateTime?
  started_at                                        DateTime?
  completed_at                                      DateTime?
  created_at                                        DateTime                      @default(now())
  updated_at                                        DateTime                      @default(now())
  deleted_at                                        DateTime?
  finance_requests                                  finance_requests[]
  financial_transactions                            financial_transactions[]
  proposals                                         proposals[]
  requirement_requests                              requirement_requests[]
  work_program_status_history                       work_program_status_history[]
  users                                             users                         @relation(fields: [created_by_user_id], references: [id], map: "fk_work_programs_creator")
  periods                                           periods                       @relation(fields: [period_id, tenant_id], references: [id, tenant_id], map: "fk_work_programs_period_scope")
  members                                           members?                      @relation(fields: [responsible_member_id, tenant_id], references: [id, tenant_id], map: "fk_work_programs_responsible_scope")
  tenants_work_programs_reviewer_tenant_idTotenants tenants?                      @relation("work_programs_reviewer_tenant_idTotenants", fields: [reviewer_tenant_id], references: [id], onDelete: Restrict, map: "fk_work_programs_reviewer_tenant")
  tenants_work_programs_tenant_idTotenants          tenants                       @relation("work_programs_tenant_idTotenants", fields: [tenant_id], references: [id], map: "fk_work_programs_tenant")

  @@unique([id, tenant_id], map: "uq_work_programs_id_tenant")
  @@unique([tenant_id, code], map: "uq_work_programs_tenant_code")
  @@index([created_by_user_id], map: "fk_work_programs_creator")
  @@index([period_id, tenant_id], map: "fk_work_programs_period_scope")
  @@index([responsible_member_id, tenant_id], map: "fk_work_programs_responsible_scope")
  @@index([period_id], map: "idx_work_programs_period")
  @@index([reviewer_tenant_id, status], map: "idx_work_programs_reviewer_status")
  @@index([tenant_id, status, start_date], map: "idx_work_programs_tenant_status_date")
}

