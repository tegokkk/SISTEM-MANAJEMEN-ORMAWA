generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id                                           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actor_user_id                                BigInt?  @db.UnsignedBigInt
  actor_tenant_id                              BigInt?  @db.UnsignedBigInt
  action                                       String   @db.VarChar(100)
  object_type                                  String   @db.VarChar(80)
  object_id                                    BigInt?  @db.UnsignedBigInt
  object_tenant_id                             BigInt?  @db.UnsignedBigInt
  request_id                                   String?  @db.VarChar(100)
  ip_address                                   Bytes?   @db.VarBinary(16)
  user_agent                                   String?  @db.VarChar(500)
  before_data                                  String?  @db.LongText
  after_data                                   String?  @db.LongText
  metadata                                     String?  @db.LongText
  created_at                                   DateTime @default(now())
  users                                        users?   @relation(fields: [actor_user_id], references: [id], map: "fk_audit_logs_actor")
  tenants_audit_logs_actor_tenant_idTotenants  tenants? @relation("audit_logs_actor_tenant_idTotenants", fields: [actor_tenant_id], references: [id], map: "fk_audit_logs_actor_tenant")
  tenants_audit_logs_object_tenant_idTotenants tenants? @relation("audit_logs_object_tenant_idTotenants", fields: [object_tenant_id], references: [id], map: "fk_audit_logs_object_tenant")

  @@index([action, created_at], map: "idx_audit_logs_action_created")
  @@index([actor_user_id, created_at], map: "idx_audit_logs_actor_created")
  @@index([actor_tenant_id, created_at], map: "idx_audit_logs_actor_tenant_created")
  @@index([object_type, object_id, created_at], map: "idx_audit_logs_object")
  @@index([object_tenant_id, created_at], map: "idx_audit_logs_object_tenant_created")
}

model auth_sessions {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id          BigInt    @db.UnsignedBigInt
  token_hash       String    @unique(map: "uq_auth_sessions_token_hash") @db.Char(64)
  active_tenant_id BigInt?   @db.UnsignedBigInt
  ip_address       Bytes?    @db.VarBinary(16)
  user_agent       String?   @db.VarChar(500)
  expires_at       DateTime
  revoked_at       DateTime?
  created_at       DateTime  @default(now())
  tenants          tenants?  @relation(fields: [active_tenant_id], references: [id], map: "fk_auth_sessions_active_tenant")
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_auth_sessions_user")

  @@index([active_tenant_id], map: "idx_auth_sessions_active_tenant")
  @@index([user_id, expires_at], map: "idx_auth_sessions_user_expiry")
}

model conversations {
  id                                            BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  hmj_tenant_id                                 BigInt               @db.UnsignedBigInt
  hima_tenant_id                                BigInt               @db.UnsignedBigInt
  subject                                       String?              @db.VarChar(180)
  status                                        conversations_status @default(ACTIVE)
  created_by_user_id                            BigInt               @db.UnsignedBigInt
  last_message_at                               DateTime?
  created_at                                    DateTime             @default(now())
  updated_at                                    DateTime             @default(now())
  users                                         users                @relation(fields: [created_by_user_id], references: [id], map: "fk_conversations_creator")
  tenants_conversations_hima_tenant_idTotenants tenants              @relation("conversations_hima_tenant_idTotenants", fields: [hima_tenant_id], references: [id], map: "fk_conversations_hima")
  tenants_conversations_hmj_tenant_idTotenants  tenants              @relation("conversations_hmj_tenant_idTotenants", fields: [hmj_tenant_id], references: [id], map: "fk_conversations_hmj")
  messages                                      messages[]

  @@unique([hmj_tenant_id, hima_tenant_id], map: "uq_conversations_hmj_hima")
  @@index([created_by_user_id], map: "fk_conversations_creator")
  @@index([hima_tenant_id, last_message_at], map: "idx_conversations_hima_last_message")
  @@index([hmj_tenant_id, last_message_at], map: "idx_conversations_hmj_last_message")
}

model departments {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  code                String                @unique(map: "uq_departments_code") @db.VarChar(30)
  name                String                @unique(map: "uq_departments_name") @db.VarChar(150)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @default(now())
  study_programs      study_programs[]
  tenant_applications tenant_applications[]
  tenants             tenants[]

  @@index([is_active], map: "idx_departments_active")
}

model email_verifications {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  token_hash String    @unique(map: "uq_email_verification_token_hash") @db.Char(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_email_verification_user")

  @@index([user_id, expires_at], map: "idx_email_verification_user_expiry")
}

model files {
  id                        BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                 BigInt?                     @db.UnsignedBigInt
  uploaded_by_user_id       BigInt                      @db.UnsignedBigInt
  storage_driver            String                      @db.VarChar(30)
  storage_key               String                      @unique(map: "uq_files_storage_key") @db.VarChar(500)
  original_name             String                      @db.VarChar(255)
  mime_type                 String                      @db.VarChar(150)
  extension                 String?                     @db.VarChar(20)
  size_bytes                BigInt                      @db.UnsignedBigInt
  checksum_sha256           String?                     @db.Char(64)
  visibility                files_visibility            @default(PRIVATE)
  scan_status               files_scan_status           @default(PENDING)
  created_at                DateTime                    @default(now())
  deleted_at                DateTime?
  tenants                   tenants?                    @relation(fields: [tenant_id], references: [id], onDelete: Restrict, map: "fk_files_tenant")
  users                     users                       @relation(fields: [uploaded_by_user_id], references: [id], map: "fk_files_uploader")
  finance_request_files     finance_request_files[]
  financial_transactions    financial_transactions[]
  messages                  messages[]
  proposals                 proposals[]
  requirement_request_files requirement_request_files[]
  tenant_application_files  tenant_application_files[]
  tenant_public_profiles    tenant_public_profiles[]

  @@index([deleted_at], map: "idx_files_deleted_at")
  @@index([tenant_id, created_at], map: "idx_files_tenant_created")
  @@index([uploaded_by_user_id], map: "idx_files_uploader")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model finance_request_files {
  finance_request_id BigInt           @db.UnsignedBigInt
  file_id            BigInt           @db.UnsignedBigInt
  document_type      String           @db.VarChar(80)
  created_at         DateTime         @default(now())
  files              files            @relation(fields: [file_id], references: [id], map: "fk_finance_request_files_file")
  finance_requests   finance_requests @relation(fields: [finance_request_id], references: [id], onDelete: Cascade, map: "fk_finance_request_files_request")

  @@id([finance_request_id, file_id])
  @@index([file_id], map: "fk_finance_request_files_file")
}

model finance_request_items {
  id                   BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  finance_request_id   BigInt           @db.UnsignedBigInt
  description          String           @db.VarChar(255)
  quantity             Decimal          @default(1.00) @db.Decimal(14, 2)
  unit                 String           @default("item") @db.VarChar(30)
  requested_unit_price Decimal          @default(0.00) @db.Decimal(18, 2)
  approved_quantity    Decimal?         @db.Decimal(14, 2)
  approved_unit_price  Decimal?         @db.Decimal(18, 2)
  note                 String?          @db.VarChar(500)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @default(now())
  finance_requests     finance_requests @relation(fields: [finance_request_id], references: [id], onDelete: Cascade, map: "fk_finance_request_items_request")

  @@index([finance_request_id], map: "idx_finance_request_items_request")
}

model finance_request_status_history {
  id                 BigInt                                      @id @default(autoincrement()) @db.UnsignedBigInt
  finance_request_id BigInt                                      @db.UnsignedBigInt
  from_status        finance_request_status_history_from_status?
  to_status          finance_request_status_history_to_status
  actor_user_id      BigInt                                      @db.UnsignedBigInt
  actor_tenant_id    BigInt?                                     @db.UnsignedBigInt
  note               String?                                     @db.Text
  created_at         DateTime                                    @default(now())
  users              users                                       @relation(fields: [actor_user_id], references: [id], map: "fk_finance_request_history_actor")
  tenants            tenants?                                    @relation(fields: [actor_tenant_id], references: [id], map: "fk_finance_request_history_actor_tenant")
  finance_requests   finance_requests                            @relation(fields: [finance_request_id], references: [id], onDelete: Cascade, map: "fk_finance_request_history_request")

  @@index([actor_user_id], map: "fk_finance_request_history_actor")
  @@index([actor_tenant_id], map: "fk_finance_request_history_actor_tenant")
  @@index([finance_request_id, created_at], map: "idx_finance_request_history_request")
}

model finance_requests {
  id                                                 BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  source_tenant_id                                   BigInt                           @db.UnsignedBigInt
  target_tenant_id                                   BigInt?                          @db.UnsignedBigInt
  work_program_id                                    BigInt                           @db.UnsignedBigInt
  request_number                                     String                           @db.VarChar(60)
  title                                              String                           @db.VarChar(180)
  description                                        String?                          @db.Text
  requested_amount                                   Decimal                          @default(0.00) @db.Decimal(18, 2)
  approved_amount                                    Decimal?                         @db.Decimal(18, 2)
  status                                             finance_requests_status          @default(DRAFT)
  created_by_user_id                                 BigInt                           @db.UnsignedBigInt
  reviewer_user_id                                   BigInt?                          @db.UnsignedBigInt
  reviewer_note                                      String?                          @db.Text
  submitted_at                                       DateTime?
  reviewed_at                                        DateTime?
  disbursed_at                                       DateTime?
  created_at                                         DateTime                         @default(now())
  updated_at                                         DateTime                         @default(now())
  finance_request_files                              finance_request_files[]
  finance_request_items                              finance_request_items[]
  finance_request_status_history                     finance_request_status_history[]
  users_finance_requests_created_by_user_idTousers   users                            @relation("finance_requests_created_by_user_idTousers", fields: [created_by_user_id], references: [id], map: "fk_finance_requests_creator")
  work_programs                                      work_programs                    @relation(fields: [work_program_id, source_tenant_id], references: [id, tenant_id], map: "fk_finance_requests_program_scope")
  users_finance_requests_reviewer_user_idTousers     users?                           @relation("finance_requests_reviewer_user_idTousers", fields: [reviewer_user_id], references: [id], map: "fk_finance_requests_reviewer")
  tenants_finance_requests_source_tenant_idTotenants tenants                          @relation("finance_requests_source_tenant_idTotenants", fields: [source_tenant_id], references: [id], map: "fk_finance_requests_source")
  tenants_finance_requests_target_tenant_idTotenants tenants?                         @relation("finance_requests_target_tenant_idTotenants", fields: [target_tenant_id], references: [id], onDelete: Restrict, map: "fk_finance_requests_target")
  financial_transactions                             financial_transactions[]

  @@unique([id, source_tenant_id], map: "uq_finance_requests_id_source")
  @@unique([source_tenant_id, request_number], map: "uq_finance_requests_number")
  @@index([created_by_user_id], map: "fk_finance_requests_creator")
  @@index([work_program_id, source_tenant_id], map: "fk_finance_requests_program_scope")
  @@index([reviewer_user_id], map: "fk_finance_requests_reviewer")
  @@index([source_tenant_id, status, created_at], map: "idx_finance_requests_source_status")
  @@index([target_tenant_id, status, created_at], map: "idx_finance_requests_target_status")
}

model financial_transactions {
  id                                                     BigInt                                  @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                                              BigInt                                  @db.UnsignedBigInt
  transaction_number                                     String                                  @db.VarChar(60)
  transaction_type                                       financial_transactions_transaction_type
  category_id                                            BigInt                                  @db.UnsignedBigInt
  work_program_id                                        BigInt?                                 @db.UnsignedBigInt
  finance_request_id                                     BigInt?                                 @db.UnsignedBigInt
  attachment_file_id                                     BigInt?                                 @db.UnsignedBigInt
  transaction_date                                       DateTime                                @db.Date
  amount                                                 Decimal                                 @db.Decimal(18, 2)
  description                                            String                                  @db.VarChar(500)
  payment_method                                         String?                                 @db.VarChar(60)
  status                                                 financial_transactions_status           @default(DRAFT)
  created_by_user_id                                     BigInt                                  @db.UnsignedBigInt
  posted_by_user_id                                      BigInt?                                 @db.UnsignedBigInt
  posted_at                                              DateTime?
  voided_by_user_id                                      BigInt?                                 @db.UnsignedBigInt
  voided_at                                              DateTime?
  void_reason                                            String?                                 @db.VarChar(500)
  created_at                                             DateTime                                @default(now())
  updated_at                                             DateTime                                @default(now())
  files                                                  files?                                  @relation(fields: [attachment_file_id], references: [id], map: "fk_financial_transactions_attachment")
  transaction_categories                                 transaction_categories                  @relation(fields: [category_id, tenant_id], references: [id, tenant_id], map: "fk_financial_transactions_category_scope")
  users_financial_transactions_created_by_user_idTousers users                                   @relation("financial_transactions_created_by_user_idTousers", fields: [created_by_user_id], references: [id], map: "fk_financial_transactions_creator")
  finance_requests                                       finance_requests?                       @relation(fields: [finance_request_id, tenant_id], references: [id, source_tenant_id], map: "fk_financial_transactions_finance_request_scope")
  users_financial_transactions_posted_by_user_idTousers  users?                                  @relation("financial_transactions_posted_by_user_idTousers", fields: [posted_by_user_id], references: [id], map: "fk_financial_transactions_poster")
  work_programs                                          work_programs?                          @relation(fields: [work_program_id, tenant_id], references: [id, tenant_id], map: "fk_financial_transactions_program_scope")
  tenants                                                tenants                                 @relation(fields: [tenant_id], references: [id], map: "fk_financial_transactions_tenant")
  users_financial_transactions_voided_by_user_idTousers  users?                                  @relation("financial_transactions_voided_by_user_idTousers", fields: [voided_by_user_id], references: [id], map: "fk_financial_transactions_voider")

  @@unique([tenant_id, transaction_number], map: "uq_financial_transactions_number")
  @@index([attachment_file_id], map: "fk_financial_transactions_attachment")
  @@index([category_id, tenant_id], map: "fk_financial_transactions_category_scope")
  @@index([created_by_user_id], map: "fk_financial_transactions_creator")
  @@index([finance_request_id, tenant_id], map: "fk_financial_transactions_finance_request_scope")
  @@index([posted_by_user_id], map: "fk_financial_transactions_poster")
  @@index([work_program_id, tenant_id], map: "fk_financial_transactions_program_scope")
  @@index([voided_by_user_id], map: "fk_financial_transactions_voider")
  @@index([finance_request_id], map: "idx_financial_transactions_finance_request")
  @@index([work_program_id], map: "idx_financial_transactions_program")
  @@index([tenant_id, transaction_date, transaction_type], map: "idx_financial_transactions_tenant_date_type")
  @@index([tenant_id, status], map: "idx_financial_transactions_tenant_status")
}

model inventory_items {
  id                                              BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                                       BigInt                         @db.UnsignedBigInt
  code                                            String                         @db.VarChar(60)
  name                                            String                         @db.VarChar(180)
  description                                     String?                        @db.Text
  category                                        String?                        @db.VarChar(100)
  quantity                                        Decimal                        @default(0.00) @db.Decimal(14, 2)
  minimum_quantity                                Decimal                        @default(0.00) @db.Decimal(14, 2)
  unit                                            String                         @default("unit") @db.VarChar(30)
  item_condition                                  inventory_items_item_condition @default(GOOD)
  location                                        String?                        @db.VarChar(180)
  acquisition_source                              String?                        @db.VarChar(180)
  acquisition_date                                DateTime?                      @db.Date
  acquisition_value                               Decimal?                       @db.Decimal(18, 2)
  status                                          inventory_items_status         @default(ACTIVE)
  created_by_user_id                              BigInt                         @db.UnsignedBigInt
  updated_by_user_id                              BigInt?                        @db.UnsignedBigInt
  created_at                                      DateTime                       @default(now())
  updated_at                                      DateTime                       @default(now())
  deleted_at                                      DateTime?
  users_inventory_items_created_by_user_idTousers users                          @relation("inventory_items_created_by_user_idTousers", fields: [created_by_user_id], references: [id], map: "fk_inventory_items_creator")
  tenants                                         tenants                        @relation(fields: [tenant_id], references: [id], map: "fk_inventory_items_tenant")
  users_inventory_items_updated_by_user_idTousers users?                         @relation("inventory_items_updated_by_user_idTousers", fields: [updated_by_user_id], references: [id], map: "fk_inventory_items_updater")
  inventory_movements                             inventory_movements[]

  @@unique([id, tenant_id], map: "uq_inventory_items_id_tenant")
  @@unique([tenant_id, code], map: "uq_inventory_items_tenant_code")
  @@index([created_by_user_id], map: "fk_inventory_items_creator")
  @@index([updated_by_user_id], map: "fk_inventory_items_updater")
  @@index([tenant_id, status, item_condition], map: "idx_inventory_items_tenant_status_condition")
}

model inventory_movements {
  id                 BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id          BigInt                            @db.UnsignedBigInt
  inventory_item_id  BigInt                            @db.UnsignedBigInt
  movement_type      inventory_movements_movement_type
  quantity_delta     Decimal                           @db.Decimal(14, 2)
  resulting_quantity Decimal                           @db.Decimal(14, 2)
  note               String?                           @db.VarChar(500)
  actor_user_id      BigInt                            @db.UnsignedBigInt
  created_at         DateTime                          @default(now())
  users              users                             @relation(fields: [actor_user_id], references: [id], map: "fk_inventory_movements_actor")
  inventory_items    inventory_items                   @relation(fields: [inventory_item_id, tenant_id], references: [id, tenant_id], map: "fk_inventory_movements_item_scope")

  @@index([actor_user_id], map: "fk_inventory_movements_actor")
  @@index([inventory_item_id, tenant_id], map: "fk_inventory_movements_item_scope")
  @@index([inventory_item_id, created_at], map: "idx_inventory_movements_item_created")
  @@index([tenant_id, created_at], map: "idx_inventory_movements_tenant_created")
}

model members {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                BigInt                     @db.UnsignedBigInt
  user_id                  BigInt?                    @db.UnsignedBigInt
  study_program_id         BigInt?                    @db.UnsignedBigInt
  student_number           String                     @db.VarChar(50)
  full_name                String                     @db.VarChar(150)
  email                    String?
  phone                    String?                    @db.VarChar(30)
  cohort_year              Int?                       @db.UnsignedSmallInt
  gender                   members_gender             @default(UNSPECIFIED)
  status                   members_status             @default(ACTIVE)
  joined_at                DateTime?                  @db.Date
  left_at                  DateTime?                  @db.Date
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @default(now())
  deleted_at               DateTime?
  study_programs           study_programs?            @relation(fields: [study_program_id], references: [id], onDelete: Restrict, map: "fk_members_study_program")
  tenants                  tenants                    @relation(fields: [tenant_id], references: [id], map: "fk_members_tenant")
  users                    users?                     @relation(fields: [user_id], references: [id], map: "fk_members_user")
  organization_assignments organization_assignments[]
  work_programs            work_programs[]

  @@unique([id, tenant_id], map: "uq_members_id_tenant")
  @@unique([tenant_id, student_number], map: "uq_members_tenant_student_number")
  @@index([study_program_id], map: "idx_members_study_program")
  @@index([tenant_id, status], map: "idx_members_tenant_status")
  @@index([user_id], map: "idx_members_user")
}

model message_reads {
  message_id BigInt   @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  read_at    DateTime @default(now())
  messages   messages @relation(fields: [message_id], references: [id], onDelete: Cascade, map: "fk_message_reads_message")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_message_reads_user")

  @@id([message_id, user_id])
  @@index([user_id, read_at], map: "idx_message_reads_user")
}

model messages {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id    BigInt          @db.UnsignedBigInt
  sender_user_id     BigInt          @db.UnsignedBigInt
  sender_tenant_id   BigInt          @db.UnsignedBigInt
  body               String          @db.Text
  attachment_file_id BigInt?         @db.UnsignedBigInt
  sent_at            DateTime        @default(now())
  edited_at          DateTime?
  deleted_at         DateTime?
  message_reads      message_reads[]
  files              files?          @relation(fields: [attachment_file_id], references: [id], map: "fk_messages_attachment")
  conversations      conversations   @relation(fields: [conversation_id], references: [id], onDelete: Cascade, map: "fk_messages_conversation")
  tenants            tenants         @relation(fields: [sender_tenant_id], references: [id], map: "fk_messages_sender_tenant")
  users              users           @relation(fields: [sender_user_id], references: [id], map: "fk_messages_sender_user")

  @@index([attachment_file_id], map: "fk_messages_attachment")
  @@index([sender_tenant_id], map: "fk_messages_sender_tenant")
  @@index([conversation_id, sender_tenant_id], map: "idx_messages_conversation_sender_tenant")
  @@index([conversation_id, sent_at], map: "idx_messages_conversation_sent")
  @@index([sender_user_id, sent_at], map: "idx_messages_sender")
}

model notifications {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  recipient_user_id BigInt    @db.UnsignedBigInt
  tenant_id         BigInt?   @db.UnsignedBigInt
  notification_type String    @db.VarChar(80)
  title             String    @db.VarChar(180)
  body              String    @db.VarChar(1000)
  target_url        String?   @db.VarChar(500)
  object_type       String?   @db.VarChar(80)
  object_id         BigInt?   @db.UnsignedBigInt
  read_at           DateTime?
  created_at        DateTime  @default(now())
  users             users     @relation(fields: [recipient_user_id], references: [id], onDelete: Cascade, map: "fk_notifications_recipient")
  tenants           tenants?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, map: "fk_notifications_tenant")

